# Copy to .env and fill in. Never commit .env.
# fake   = scripted responses, no network (tests use this)
# replay = recorded responses from evals/recordings (no API key needed)
# live   = real Anthropic API calls (needs ANTHROPIC_API_KEY)
LLM_MODE=fake
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-4-5
RESOLVER_MODEL=claude-sonnet-5-5
DATABASE_PATH=declinedesk.sqlite3
