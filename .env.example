# Copy to .env and fill in. .env is gitignored: never commit a key.
#
# LLM_MODE
#   fake = scripted model responses, no network, no key (tests and the bundled demo)
#   live = real model calls with YOUR OWN key (see README: "Use a real model")
LLM_MODE=fake

# LLM_PROVIDER: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# Only the key for the provider you chose is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the provider's default models (cheap triage, stronger drafting).
#   anthropic: claude-haiku-4-5 / claude-sonnet-5-5
#   openai:    gpt-5-nano       / gpt-5.1
#   gemini:    gemini-3.5-flash-lite / gemini-3.8-flash
TRIAGE_MODEL=
RESOLVER_MODEL=
